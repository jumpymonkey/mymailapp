# Local development environment configuration (copy to .env — never commit .env)
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-with-44-char-urlsafe-base64-fernet-key=
GMAIL_MAX_CONCURRENCY=10
INLINE_CID_MAX_BYTES=2097152
